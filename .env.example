# --- Email (IMAP + app password) ---
# Your own account or your college-provided one. Run `npm run detect` after filling
# in GMAIL_USER / GMAIL_APP_PASSWORD and it will find the right server automatically.
# For Google-hosted accounts (imap.gmail.com), enable 2-Step Verification at
# https://myaccount.google.com/security then create an app password at
# https://myaccount.google.com/apppasswords
# (Note: a college that uses Google Workspace usually works the same way.)
GMAIL_USER=you@yourcollege.edu
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Leave empty to let `npm run detect` figure out the host.
# Office 365 mailbox? Set IMAP_HOST=outlook.office365.com (app password at account.microsoft.com).
# IMAP_HOST=imap.gmail.com

# Comma-separated list of senders to alert on.
# Use "someone@gmail.com" for exact match or "@company.com" to match any address at that domain.
WATCH_SENDERS=someone@gmail.com

# --- Google AI Studio (Gemini) ---
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Optional ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
POLL_INTERVAL_SECONDS=30
PORT=3000