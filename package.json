{
  "name": "mailwatch",
  "version": "1.0.0",
  "description": "Personal AI alert: watches Gmail for mail from specific senders and summarizes matches via Gemini",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "detect": "node scripts/detect-imap.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^1.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "imapflow": "^1.0.164",
    "mailparser": "^3.7.1",
    "node-notifier": "^10.0.1"
  }
}
